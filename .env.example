# Continuous discovery cadence (seconds). 1800 = every 30 minutes.
DISCOVERY_INTERVAL_SECONDS=1800

# Training configuration
TRAINING_EPOCHS=20
BATCH_SIZE=128
LEARNING_RATE=0.003
CONTEXT_SIZE=8
EMBEDDING_DIM=2
HIDDEN_SIZE=8
MAX_PARAMETERS=1000
PROMOTION_MAX_REGRESSION=0.02

# Set a descriptive Wikimedia User-Agent and contact/project URL if available.
WIKIPEDIA_USER_AGENT=PatternLearner/0.2 (self-hosted educational research project)
